// DCE-NOT: atom.add
// DCE-NOT: atom.mul
// DCE-NOT: atom.alloc_shared
// DCE: %v2 = atom.const 1 : index
// DCE: %v3 = atom.const 2 : index
// DCE: %v4 = atom.load
// DCE-NOT: atom.mul
// DCE-NOT: atom.add
// DCE: atom.store
// DCE-NOT: atom.mul
// DCE-NOT: atom.alloc_shared
// DCE: atom.loop_for
// DCE: %v5 = atom.const 3 : f32
// DCE: atom.store
// DCE: atom.barrier

// DIV0-LABEL: atom.kernel @div0(
// DIV0: %v1 = atom.const 7 : i32
// DIV0: %v2 = atom.const 0 : i32
// DIV0: %v3 = atom.div %v1, %v2 : i32
// DIV0: atom.store
// DIV0-NOT: atom.add
// DIV0-NOT: atom.mul

// FLOAT0-LABEL: atom.kernel @float_mul0(
