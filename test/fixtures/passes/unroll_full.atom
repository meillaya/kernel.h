// Unroll fixture (FULL): a reduction-style loop with trip count 4 and
// unroll = 4. The pinned full-unroll rule applies (trip <= 8 AND unroll >=
// trip), so the pass removes the loop entirely and emits 4 sequential copies
// of the body; the iter_args carry chain (the f32 accumulator) threads
// through all four copies and the final value is stored.
atom.kernel @unroll_full(%v0: tensor<4xf32, global>, %v1: tensor<4xf32, global>) {
  tile = []
  map_blocks = false
  map_warps = false
  use_shared_memory = false
  vector_width = 1
  unroll = 4
  shape = {n = 4}
  %v2 = atom.const 0 : index
  %v3 = atom.const 4 : index
  %v4 = atom.const 1 : index
  %v5 = atom.const 0.0 : f32
  %v6 = atom.loop_for %v2 to %v3 step %v4 iter_args(%v5) -> (f32) {
    ^bb0(%v7: index, %v8: f32):
      %v9 = atom.load %v0[%v7] : tensor<4xf32, global>
      %v10 = atom.add %v9, %v8 : f32
      atom.yield %v10 : f32
  }
  atom.store %v6, %v1[%v2] : tensor<4xf32, global>
}
