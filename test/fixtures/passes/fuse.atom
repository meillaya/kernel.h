// Fuse fixture: z = tanh(a*x + b) computed as TWO elementwise loops sharing
// one iteration domain, with an intermediate shared tensor t. The fuse pass
// must merge the loops into ONE nest, rewrite the consumer's loads of t to
// the producer's stored value, and eliminate t (its alloc_shared becomes
// dead and is erased).
atom.kernel @fuse(%v0: tensor<1024xf32, global>, %v1: tensor<1024xf32, global>, %v2: tensor<1024xf32, global>) {
  tile = [1024]
  map_blocks = true
  map_warps = false
  use_shared_memory = true
  vector_width = 1
  unroll = 1
  shape = {n = 1024}
  %v3 = atom.const 0 : index
  %v4 = atom.const 1024 : index
  %v5 = atom.const 1 : index
  %v6 = atom.alloc_shared : tensor<1024xf32, shared>
  atom.loop_for %v3 to %v4 step %v5 iter_args() -> () {
    ^bb0(%v8: index):
      %v9 = atom.load %v0[%v8] : tensor<1024xf32, global>
      %v10 = atom.const 2 : f32
      %v11 = atom.mul %v9, %v10 : f32
      %v12 = atom.load %v1[%v8] : tensor<1024xf32, global>
      %v13 = atom.add %v11, %v12 : f32
      atom.store %v13, %v6[%v8] : tensor<1024xf32, shared>
      atom.yield
  }
  atom.loop_for %v3 to %v4 step %v5 iter_args() -> () {
    ^bb0(%v15: index):
      %v16 = atom.load %v6[%v15] : tensor<1024xf32, shared>
      %v17 = atom.math tanh %v16 : f32
      atom.store %v17, %v2[%v15] : tensor<1024xf32, global>
      atom.yield
  }
}
