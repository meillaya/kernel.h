// CSE fixture: identical pure ops within one scope reuse the earlier result.
// Identical loads are NOT merged (memory reads excluded), so both survive.
atom.kernel @cse(%v0: tensor<8xf32, global>) {
  tile = []
  map_blocks = false
  map_warps = false
  use_shared_memory = false
  vector_width = 1
  unroll = 1
  shape = {}
  %v1 = atom.const 0 : index
  %v2 = atom.load %v0[%v1] : tensor<8xf32, global>
  %v3 = atom.load %v0[%v1] : tensor<8xf32, global>
  %v4 = atom.const 2 : f32
  %v5 = atom.mul %v2, %v4 : f32
  %v6 = atom.mul %v2, %v4 : f32
  %v7 = atom.add %v2, %v4 : f32
  %v8 = atom.add %v2, %v4 : f32
  %v9 = atom.mul %v3, %v4 : f32
  atom.store %v5, %v0[%v1] : tensor<8xf32, global>
  atom.store %v6, %v0[%v1] : tensor<8xf32, global>
  atom.store %v7, %v0[%v1] : tensor<8xf32, global>
  atom.store %v8, %v0[%v1] : tensor<8xf32, global>
  atom.store %v9, %v0[%v1] : tensor<8xf32, global>
}
