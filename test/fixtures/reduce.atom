// Reduction-shaped fixture for the emitter (plan todo 21): atom.reduce over
// dim 0 of a rank-1 tensor (sum + max). The leaf op lowers to a sequential
// scf.for over the reduced dim with iter_args.
atom.kernel @reduce(%v0: tensor<256xf32, global>, %v1: tensor<256xf32, global>) {
  tile = [256]
  map_blocks = true
  map_warps = false
  use_shared_memory = false
  vector_width = 1
  unroll = 1
  shape = {n = 256}
  %v2 = atom.const 0 : index
  %v3 = atom.const 1 : index
  %v4 = atom.thread_id x : index
  %v5 = atom.block_id x : index
  %v6 = atom.block_dim x : index
  %v7 = atom.mul %v5, %v6 : index
  %v8 = atom.add %v7, %v4 : index
  %v9 = atom.reduce sum %v0, dim = 0 : tensor<256xf32, global>
  %v10 = atom.reduce max %v0, dim = 0 : tensor<256xf32, global>
  atom.store %v9, %v1[%v8] : tensor<256xf32, global>
  atom.store %v10, %v1[%v8] : tensor<256xf32, global>
}
